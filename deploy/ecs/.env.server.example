PROXY_API_KEY="replace-with-a-long-random-secret"

# The container should listen on all interfaces inside Docker.
SERVER_HOST="0.0.0.0"
SERVER_PORT="8000"

# Account system configuration stored in a mounted runtime directory.
ACCOUNT_SYSTEM=true
ACCOUNTS_CONFIG_FILE="/app/runtime/credentials.json"
ACCOUNTS_STATE_FILE="/app/runtime/state.json"

# Optional operational settings.
DEBUG_MODE="errors"
LOG_LEVEL="INFO"

# Malaysia ECS can usually reach AWS directly.
# Leave empty unless you later add an outbound proxy.
VPN_PROXY_URL=""
